{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(pio check:*)",
      "Bash(pio run)",
      "Bash(pio run -e nodemcuv2)",
      "Bash(pio run -e nodemcuv2_DEBUG)",
      "Bash(pio test:*)",
      "Bash(pre-commit run:*)"
    ],
    "ask": [
      "Bash(pio device monitor:*)",
      "Bash(pio run --target upload:*)",
      "Bash(pio run -t upload:*)"
    ],
    "deny": [
      "Read(./secrets.ini)"
    ]
  }
}
