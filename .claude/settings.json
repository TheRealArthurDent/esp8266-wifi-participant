{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|Edit|Write|NotebookEdit)$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(pio check:*)",
      "Bash(pio run)",
      "Bash(pio run -e nodemcuv2)",
      "Bash(pio run -e nodemcuv2_DEBUG)",
      "Bash(pio test:*)",
      "Bash(pre-commit run:*)"
    ],
    "ask": [
      "Bash(pio device monitor:*)",
      "Bash(pio run --target upload:*)",
      "Bash(pio run -t upload:*)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/hooks/**)",
      "Write(./.claude/settings.json)"
    ],
    "deny": [
      "Bash(docker:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(pio project config:*)",
      "Edit(./secrets.ini)",
      "Read(./secrets.ini)",
      "Write(./secrets.ini)"
    ]
  }
}
