{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "PlatformIO platforms and libraries in platformio.ini, each annotated with a `; renovate:` comment. Renovate has no PlatformIO manager.",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "managerFilePatterns": [
        "/(^|/)platformio\\.ini$/"
      ],
      "matchStrings": [
        "; renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n@]+@(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "The ESP8266 Arduino core that the compile-sketch workflow installs.",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/compile-sketch\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*version: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "The ESP8266 Arduino core that the software-in-the-loop (SIL) tests in test-sil/run.sh build against.",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "managerFilePatterns": [
        "/(^|/)test-sil/run\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nCORE_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "addLabels": [
        "auto-merge"
      ],
      "automerge": true,
      "description": "Automerge minor, patch, pin and digest updates to github-actions, pip_requirements and pyenv, except PlatformIO, which changes the firmware toolchain. main requires a review, so Renovate opens a PR, the renovate-approve workflow approves it (it carries the auto-merge label) and Renovate merges it once all checks are green (#141).",
      "groupName": "auto merge",
      "matchManagers": [
        "github-actions",
        "pip_requirements",
        "pyenv"
      ],
      "matchPackageNames": [
        "!platformio"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    },
    {
      "automerge": false,
      "description": "Create PRs for major changes to github-actions, pip_requirements and pyenv.",
      "matchManagers": [
        "github-actions",
        "pip_requirements",
        "pyenv"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "addLabels": [
        "auto-merge"
      ],
      "automerge": true,
      "description": "Automerge minor, patch, pin and digest updates to pre-commit hooks, the same way as above.",
      "groupName": "pre-commit",
      "matchDatasources": [
        "github-releases"
      ],
      "matchManagers": [
        "regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "schedule": [
        "before 5am on Tuesday"
      ]
    },
    {
      "automerge": false,
      "description": "Create PRs for major changes to pre-commit actions.",
      "groupName": "pre-commit MAJOR",
      "matchDatasources": [
        "github-releases"
      ],
      "matchManagers": [
        "regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "schedule": [
        "before 5am on Tuesday"
      ]
    }
  ],
  "platformAutomerge": false,
  "reviewers": [
    "TheRealArthurDent"
  ]
}
