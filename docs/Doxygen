PROJECT_NAME     = ESP8266 WiFi Participant
INPUT            = src \
                   include \
                   docs
INCLUDE_PATH     = include
OUTPUT_DIRECTORY = docs/generated
# Only the HTML is published; LaTeX would also need a TeX installation.
GENERATE_LATEX   = NO
# Fail the build (and CI) on any warning, after a complete run.
WARN_NO_PARAMDOC = YES
WARN_AS_ERROR    = FAIL_ON_WARNINGS
